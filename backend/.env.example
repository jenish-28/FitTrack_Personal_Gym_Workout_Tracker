# FitTrack Backend Environment Configuration (Example)
# Copy this file to .env and replace placeholder values with your own secrets.

DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/fittrack
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/fittrack_test

JWT_SECRET_KEY=replace-with-a-secure-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ENVIRONMENT=development
ENABLE_DEMO_ACCOUNT=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
